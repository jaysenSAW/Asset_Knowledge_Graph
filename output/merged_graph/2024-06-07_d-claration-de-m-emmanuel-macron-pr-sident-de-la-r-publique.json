    },
    {
      "source": "France",
      "relation": "LOCATED_IN",
      "target": "Bayeux",
      "evidence": "C'est décidé à Bayeux, \" la France renaîtra avec notre peuple, pour notre peuple, par notre peuple \".",
      "confidence": 1.0,
      "source_id": "Country_abc848c68a51b729ff02b3ae34ff713995ee62f79a65d51e0bedfd6a96939f59",
      "target_id": "City_e9cce07ffbb5632c3dee462cb70a673d2abd01fb4ef21effd7478fee65851116"
    },
    {
      "source": "France",
      "relation": "LOCATED_IN",
      "target": "France",
      "evidence": "La France reparaît alors, universelle et fière, comme l'appelait pour l'avenir Marc Bloch avant sa mort.",
      "confidence": 1.0,
      "source_id": "Country_abc848c68a51b729ff02b3ae34ff713995ee62f79a65d51e0bedfd6a96939f59",
      "target_id": "Country_abc848c68a51b729ff02b3ae34ff713995ee62f79a65d51e0bedfd6a96939f59"
